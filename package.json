{
  "name": "@moxisuki/dsh-preset-plus-vanta",
  "version": "0.2.0",
  "description": "DeepSeek Harness preset enhancement (fork of @rain-kl/dsh-preset-plus): editable presets (system/user/assistant entries + prefill seeds) applied to the `vanta` agent mode. Registers its agent preset declaratively, so no $DSH_HOME/.agent-presets directory is used.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "presets",
    "scripts",
    "docs",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/assert-build.mjs",
    "lint": "node --check lib/index.js && node --check lib/core.js && node --check client.js",
    "release": "node scripts/release.mjs"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "preset",
    "prefill",
    "agent"
  ],
  "author": "moxisuki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moxisuki/dsh-preset-plus-vanta.git"
  },
  "bugs": {
    "url": "https://github.com/moxisuki/dsh-preset-plus-vanta/issues"
  },
  "homepage": "https://github.com/moxisuki/dsh-preset-plus-vanta#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
